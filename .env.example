# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL + PostGIS connection string used by src/backend/database.py.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/raksha_path

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to localhost:3000/5173 if unset — override for a deployed frontend.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
